{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundry-event-contract/1.0.0/ontology/relationships",
  "title": "Foundry Relationship Types (HydraDB edges)",
  "description": "Canonical relationship types for the HydraDB knowledge graph.",
  "definitions": {
    "GENERATED": { "description": "IdeaGenerator -> Idea" },
    "PROPOSES": { "description": "Idea -> Capability" },
    "RESEARCHED_BY": { "description": "Idea -> ResearchReport" },
    "BUILT_FROM": { "description": "BuildRun -> Idea" },
    "BUILT_BY": { "description": "Idea -> BuildRun" },
    "PRODUCED": { "description": "BuildRun -> Product" },
    "HAS_ATTEMPT": { "description": "BuildRun -> BuildAttempt" },
    "EXECUTED_TASK": { "description": "BuildAttempt -> Task" },
    "FAILED_WITH": { "description": "BuildAttempt -> Failure" },
    "INSTANCE_OF": { "description": "Failure -> FailureClass" },
    "FIXED_BY": { "description": "Failure -> RepairAttempt" },
    "VERIFIED_BY": { "description": "RepairAttempt -> AuditFinding" },
    "CREATED_ARTIFACT": { "description": "BuildRun -> Artifact" },
    "IMPLEMENTS": { "description": "Product -> Capability" },
    "EXPOSES": { "description": "Product -> Site" },
    "DEPLOYED_AS": { "description": "Site -> Deployment" },
    "DEPENDS_ON": { "description": "Component -> Component" },
    "CONFORMS_TO": { "description": "Site -> StandardVersion" },
    "AFFECTS": { "description": "Observation -> any entity" },
    "SUPERSEDES": { "description": "Version N -> Version N-1" },
    "USED_STRATEGY": { "description": "BuildRun -> StrategyVersion" },
    "HAS_VERSION": { "description": "Strategy -> StrategyVersion" },
    "USED_MODEL": { "description": "BuildAttempt -> ModelConfiguration" },
    "OBSERVED_BY": { "description": "Observation -> Sensor/Experiment" },
    "MEASURES": { "description": "Experiment -> Observation" },
    "TESTS": { "description": "Experiment -> StandardVersion" },
    "HAS_ARM": { "description": "Experiment -> ExperimentArm" },
    "ASSIGNED_TO": { "description": "ExperimentArm -> Site" },
    "SUPPORTS": { "description": "Observation -> Hypothesis" },
    "CONTRADICTS": { "description": "Observation -> Hypothesis" },
    "DERIVED_FROM": { "description": "StrategyVersion -> Experiment/BuildRun" },
    "SUPPORTED_BY": { "description": "StrategyVersion -> BuildRun" },
    "INPUT_TO": { "description": "Entity -> ProcessRun" },
    "OUTPUT_OF": { "description": "ProcessRun -> Entity" },
    "BELONGS_TO_PROJECT": { "description": "Entity -> Project" },
    "FROM_REPOSITORY": { "description": "BuildRun -> Repository" },
    "AT_COMMIT": { "description": "BuildRun -> Commit" },
    "USED_COMPONENT": { "description": "BuildRun -> ComponentVersion" },
    "IMPLEMENTED_BY": { "description": "Capability -> ComponentVersion" },
    "HAS_PROCEDURE": { "description": "FailureClass -> Procedure" },
    "LEARNS_FROM": { "description": "Procedure -> BuildRun" }
  }
}
