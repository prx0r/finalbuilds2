{
  "id": "agent-web",
  "version": "2.0.0",
  "status": "required",
  "name": "Agent-Web Standard",
  "description": "Standards for making websites usable by autonomous agents",
  "requirements": [
    {
      "id": "llms-txt",
      "description": "Must have /llms.txt with product description, tools, API, and links",
      "check": "file_exists:public/llms.txt",
      "severity": "must"
    },
    {
      "id": "openapi",
      "description": "Must have /docs/openapi.json with API schema",
      "check": "file_exists:docs/openapi.json",
      "severity": "must"
    },
    {
      "id": "mcp-docs",
      "description": "Must have /docs/mcp.md with tool definitions",
      "check": "file_exists:docs/mcp.md",
      "severity": "must"
    },
    {
      "id": "api-docs",
      "description": "Must have /docs/api.md with endpoint specs",
      "check": "file_exists:docs/api.md",
      "severity": "must"
    },
    {
      "id": "robots-txt",
      "description": "Must have /robots.txt allowing agent crawlers",
      "check": "file_exists:public/robots.txt",
      "severity": "must"
    },
    {
      "id": "sitemap",
      "description": "Must have /sitemap.xml with lastmod timestamps",
      "check": "file_exists:public/sitemap.xml",
      "severity": "must"
    },
    {
      "id": "structured-errors",
      "description": "API errors must include code, message, retryable",
      "check": "code_pattern:retryable",
      "severity": "must"
    },
    {
      "id": "provenance",
      "description": "Outputs must include verification_method, confidence, timestamp",
      "check": "code_pattern:verification_method",
      "severity": "must"
    },
    {
      "id": "semantic-html",
      "description": "Use semantic HTML elements (article, nav, main, form, button)",
      "check": "html_semantic:semantic_elements",
      "severity": "should"
    },
    {
      "id": "canonical-url",
      "description": "Pages must have canonical URLs",
      "check": "meta_canonical:true",
      "severity": "must"
    },
    {
      "id": "json-output",
      "description": "API must return JSON with Content-Type: application/json",
      "check": "api_json:true",
      "severity": "must"
    },
    {
      "id": "cors",
      "description": "API must support CORS for agent access",
      "check": "header:Access-Control-Allow-Origin",
      "severity": "must"
    }
  ],
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-08-21",
      "changes": [
        "Added llms.txt v2 requirement",
        "Added CORS requirement",
        "Added semantic HTML recommendation",
        "Updated provenance requirements"
      ]
    },
    {
      "version": "1.0.0",
      "date": "2026-08-01",
      "changes": [
        "Initial standard"
      ]
    }
  ]
}
